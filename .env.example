SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_SECRET_KEY=sb_secret_sua_chave_aqui
# Dashboard: Project Settings > API > JWT Secret (validação local do token)
SUPABASE_JWT_SECRET=sua-jwt-secret-aqui
PORT=8080

# WPPConnect Server (WhatsApp) - a secretKey fica SOMENTE aqui no servidor
WPPCONNECT_BASE_URL=http://localhost:21465
WPPCONNECT_SECRET_KEY=troque-por-uma-chave-forte-e-secreta

# URL deste backend que o WPPConnect chama via webhook ao iniciar a sessão.
# Em produção, aponte para o domínio HTTPS do Caddy (ex.: https://SEU-IP-COM-HIFENS.sslip.io/webhook/whatsapp).
KANBAN_API_WEBHOOK_URL=http://localhost:8080/webhook/whatsapp
